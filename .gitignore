# Python bytecode and build output
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# Environments
.venv/
.env
.env.*
!.env.example
# The fixture corpus holds a decoy .env.local so a test can prove the corpus
# source never reads one. It carries no real value and is never ingested.
!tests/corpus/operational/.env.local
.vscode

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
coverage.xml
htmlcov/

# Local reference material. Never edited, never imported, never distributed.
/_research/

# Local code-intelligence index, and the config that points it at the
# uncommitted directories below — both are this checkout's business only.
/.codegraph/
/codegraph.json

# Personal agent guidance. The shared, general-audience document is AGENTS.md.
/CLAUDE.md

# Execution plans and the module-level record of what prior art each part draws
# on. The repository ships the system and the decisions behind it, not the
# sequencing of the work nor a running commentary on where code came from.
/specs/
/specs_v2/
/specs_v3/
/specs_v4/
/docs/provenance-map.md
