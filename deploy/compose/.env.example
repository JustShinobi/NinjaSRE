# NinjaSRE — every setting, its default, whether it is required, and what it affects.
#
# Generated from platform/startup/settings.py by tools/generate_env_example.py.
# Edit the catalogue, not this file: `make check-env-example` fails on drift.
#
# Copy to .env, set the two required values, and start. Everything commented
# out already has a working default.

# --- Deployment profile ------------------------------------------------------

# Which deployment shape this is. Decides the sandbox, where the credential
# proxy runs, and the concurrency ceiling — all three together. One of: dev,
# homelab, standard, enterprise.
# optional, default: dev
# NINJASRE_DEPLOYMENT_PROFILE=dev

# The first administrator's token. Generated and printed once at first start
# when unset, which is the fastest path to a reachable console.
# optional, no default
# NINJASRE_ADMIN_TOKEN=<set this>

# The organisation bring-up creates on a store that holds none. Named rather
# than derived from the hostname: an identifier that changes when the machine
# is renamed breaks every token issued before it.
# optional, default: default
# NINJASRE_ORGANISATION=default

# Where state that outlives one process but does not belong in the database is
# kept: the bootstrap credential, the last bring-up failure, a support bundle.
# Must survive a container restart, or an operator who closed the terminal
# loses their way in.
# optional, default: /var/lib/ninjasre
# NINJASRE_STATE_DIR=/var/lib/ninjasre

# Where the bootstrap credential is written, when it should not go under the
# state directory. The file is owner-readable only and is removed the moment
# the credential is exchanged for a durable one.
# optional, no default
# NINJASRE_BOOTSTRAP_CREDENTIAL_PATH=<set this>

# Serve the demonstration dataset instead of a real deployment. Every provider
# response comes from a fixture and a real network call raises, so nothing
# external is reached and nothing is billed.
# optional, default: false
# NINJASRE_DEMO_MODE=false

# A golden configuration template applied during initial setup: a shipped
# template's name, or a path to one of your own.
# optional, no default
# NINJASRE_SETUP_TEMPLATE=

# Which investigation runtime this deployment runs, as 'module:factory'.
# Composing one means choosing a provider, a capability catalogue, and a
# credential proxy — a deployment decision. Unset, every route works except
# starting an investigation, which refuses with a message naming this setting.
# optional, no default
# NINJASRE_INVESTIGATOR=

# Where the command keeps its state. Follows the platform's own conventions
# when unset — XDG on Linux, Application Support on macOS.
# optional, no default
# NINJASRE_HOME_DIR=


# --- Database ----------------------------------------------------------------

# The one PostgreSQL instance holding relational rows, vectors, and the
# service graph. Needs the pgvector and Apache AGE extensions.
# required, default: postgresql://ninjasre:ninjasre@postgres:5432/ninjasre
NINJASRE_DATABASE_URL=postgresql://ninjasre:ninjasre@postgres:5432/ninjasre

# Which schema the platform's tables live in.
# optional, default: public
# NINJASRE_DATABASE_SCHEMA=public

# Encrypts stored integration credentials at rest. NinjaSRE never generates
# one — produce it with `openssl rand -base64 32` and back it up separately
# from your database dumps. Lose it and every stored credential has to be re-
# entered.
# optional, no default
# NINJASRE_DATABASE_ENCRYPTION_KEY=<set this>


# --- Model provider — set the one you use ------------------------------------

# Which model provider to use. One provider credential is the whole minimum
# viable configuration. One of: anthropic, openai, azure_openai, aws_bedrock,
# google_gemini, google_vertex_ai, openrouter, nvidia_nim, ollama.
# required, default: anthropic
NINJASRE_LLM_PROVIDER=anthropic

# Which model, when the effective configuration names none.
# optional, default: claude-sonnet-5
# NINJASRE_LLM_MODEL=claude-sonnet-5

# How requests reach the provider. The vendor SDK is the path the contract
# suite treats as normative. One of: sdk, litellm.
# optional, default: sdk
# NINJASRE_LLM_TRANSPORT=sdk

# Authenticates the anthropic provider.
# optional, no default
# ANTHROPIC_API_KEY=<set this>

# Points the anthropic provider at your own gateway instead of the vendor's.
# optional, no default
# ANTHROPIC_BASE_URL=

# Authenticates the openai provider.
# optional, no default
# OPENAI_API_KEY=<set this>

# Points the openai provider at your own gateway, or at a local vLLM.
# optional, no default
# OPENAI_BASE_URL=

# Authenticates the azure_openai provider.
# optional, no default
# AZURE_OPENAI_API_KEY=<set this>

# Your Azure OpenAI resource's endpoint.
# optional, no default
# AZURE_OPENAI_ENDPOINT=

# Which Azure OpenAI deployment name to call.
# optional, no default
# AZURE_OPENAI_DEPLOYMENT=

# Which Azure OpenAI API version to send.
# optional, no default
# AZURE_OPENAI_API_VERSION=

# Authenticates the aws_bedrock provider, with the secret key below.
# optional, no default
# AWS_ACCESS_KEY_ID=<set this>

# The other half of the Bedrock key pair.
# optional, no default
# AWS_SECRET_ACCESS_KEY=<set this>

# A session token, when Bedrock is reached with temporary credentials.
# optional, no default
# AWS_SESSION_TOKEN=<set this>

# A named AWS profile, instead of a key pair.
# optional, no default
# AWS_PROFILE=

# Which region Bedrock is called in.
# optional, no default
# AWS_REGION=

# Points Bedrock at a VPC endpoint instead of the public one.
# optional, no default
# AWS_BEDROCK_ENDPOINT=

# Authenticates the google_gemini provider.
# optional, no default
# GOOGLE_API_KEY=<set this>

# Path to a service-account file, for google_vertex_ai.
# optional, no default
# GOOGLE_APPLICATION_CREDENTIALS=

# Which project Vertex AI calls are billed to.
# optional, no default
# GOOGLE_CLOUD_PROJECT=

# Which region Vertex AI is called in.
# optional, no default
# GOOGLE_CLOUD_LOCATION=

# Authenticates the openrouter provider.
# optional, no default
# OPENROUTER_API_KEY=<set this>

# Points openrouter somewhere other than its own endpoint.
# optional, no default
# OPENROUTER_BASE_URL=

# Authenticates the nvidia_nim provider.
# optional, no default
# NVIDIA_API_KEY=<set this>

# Points NIM at your own inference microservice rather than the hosted one.
# optional, no default
# NVIDIA_NIM_BASE_URL=

# Where your Ollama server is. This is the air-gapped path: a local model
# means a deployment with no egress at all is fully functional.
# optional, default: http://ollama:11434/v1
# OLLAMA_BASE_URL=http://ollama:11434/v1

# Where your vLLM server is, as the other local-model option.
# optional, no default
# VLLM_BASE_URL=


# --- Ports and addresses -----------------------------------------------------

# Which interface the API binds. Loopback by default: binding to every
# interface is a decision, not a default that ships open.
# optional, default: 127.0.0.1
# NINJASRE_API_HOST=127.0.0.1

# Which port the REST and SSE surface listens on.
# optional, default: 8420
# NINJASRE_API_PORT=8420

# Which port the web console listens on.
# optional, default: 8421
# NINJASRE_CONSOLE_PORT=8421

# Which port the credential proxy listens on.
# optional, default: 8422
# NINJASRE_PROXY_PORT=8422


# --- Isolation, masking, and the credential proxy ----------------------------

# The name somebody types to sign in when this deployment has no identity
# provider. Only meaningful alongside the passphrase below.
# optional, default: admin
# NINJASRE_LOCAL_ACCOUNT_USERNAME=admin

# The stored form of that passphrase, as 'ninjasre hash-password' prints it.
# Unset, there is no local account and the sign-in page refuses everything —
# which is correct for a deployment whose operators come from a directory.
# optional, no default
# NINJASRE_LOCAL_ACCOUNT_PASSWORD_HASH=<set this>

# Declares this a demonstration deployment, which is the only thing that makes
# the passphrase this project ships with acceptable. Set it and a first run
# needs no configuration at all; leave it unset and a deployment still
# carrying that passphrase refuses to start.
# optional, no default
# NINJASRE_LOCAL_ACCOUNT_DEMO=

# Where the credential proxy is. Required on any profile that runs it as its
# own service; the dev profile runs it in-process and needs none.
# optional, default: http://proxy:8422
# NINJASRE_CREDENTIAL_PROXY_URL=http://proxy:8422

# Authenticates the application to the credential proxy.
# optional, no default
# NINJASRE_CREDENTIAL_PROXY_TOKEN=<set this>

# The vault's master key, when it is supplied inline rather than from a file.
# optional, no default
# NINJASRE_VAULT_MASTER_KEY=<set this>

# Path to the vault's master key, which is the shape a secrets mount takes.
# optional, no default
# NINJASRE_VAULT_KEY_FILE=

# Overrides the isolation profile the deployment profile implies. Leave unset:
# a disagreement between the two is refused at startup.
# optional, no default
# NINJASRE_SANDBOX_PROFILE=

# Which image the container and kubernetes sandbox profiles run capabilities
# in.
# optional, no default
# NINJASRE_SANDBOX_IMAGE=

# Which Kubernetes namespace sandbox pods land in.
# optional, no default
# NINJASRE_SANDBOX_NAMESPACE=

# How many warm sandboxes stay claimable, so provisioning is off the critical
# path.
# optional, default: 2
# NINJASRE_SANDBOX_POOL_SIZE=2

# Which container binary the container sandbox profile drives.
# optional, default: docker
# NINJASRE_CONTAINER_RUNTIME=docker

# Whether sensitive values are masked before they reach a model or a log.
# optional, default: true
# NINJASRE_MASKING_ENABLED=true

# How aggressively masking rewrites what it finds.
# optional, default: standard
# NINJASRE_MASKING_POLICY=standard

# Path to your own guardrail ruleset, layered over the shipped one.
# optional, no default
# NINJASRE_GUARDRAIL_RULES_PATH=

# Where audit records go when the database cannot take them. An audit trail
# with a gap is not an audit trail.
# optional, no default
# NINJASRE_AUDIT_FALLBACK_PATH=


# --- Memory, knowledge, and the runtime --------------------------------------

# Which agent runtime runs investigations. The canonical loop is the only one
# that produces a published evaluation number.
# optional, default: canonical
# NINJASRE_RUNTIME=canonical

# Whether investigations recall past episodes.
# optional, default: true
# NINJASRE_MEMORY_READ=true

# Whether finished investigations are written to the episode corpus.
# optional, default: true
# NINJASRE_MEMORY_WRITE=true

# Whether synthesised strategies are offered to the loop.
# optional, default: true
# NINJASRE_MEMORY_STRATEGY=true

# Which model embeds episodes and knowledge. Changing it needs a re-embedding
# generation, not just a restart.
# optional, no default
# NINJASRE_EMBEDDING_MODEL=

# Whether the service graph is consulted for blast radius and dependencies.
# optional, default: true
# NINJASRE_TOPOLOGY=true

# Whether the knowledge base is retrieved from during investigations.
# optional, default: true
# NINJASRE_KNOWLEDGE=true


# --- Logging, telemetry, and air-gapped operation ----------------------------

# How much the deployment logs.
# optional, default: INFO
# NINJASRE_LOG_LEVEL=INFO

# Structured JSON for a log pipeline, or console output for a person.
# optional, default: json
# NINJASRE_LOG_FORMAT=json

# Per-module log levels as module=LEVEL pairs, comma-separated, for turning
# one subsystem up without raising the whole deployment's volume. Re-read on
# demand rather than only at start.
# optional, no default
# NINJASRE_LOG_MODULE_LEVELS=

# Where traces, metrics, and logs are exported, as an OTLP/HTTP base URL.
# Unset means nothing leaves the host, which is the default.
# optional, no default
# NINJASRE_OTEL_ENDPOINT=

# What this deployment calls itself to the collector.
# optional, default: ninjasre
# NINJASRE_TELEMETRY_SERVICE_NAME=ninjasre

# The share of traces exported, between 0 and 1. Lower it when instrumentation
# shows up in investigation latency.
# optional, default: 1.0
# NINJASRE_TELEMETRY_SAMPLE_RATIO=1.0

# Refuses to start if any setting implies an outbound connection. Turn it on
# with a local model to prove the deployment cannot phone home.
# optional, default: false
# NINJASRE_AIR_GAPPED=false

# Hosts you have consciously permitted, comma-separated. Everything the
# configuration already names is permitted by being configured.
# optional, no default
# NINJASRE_EGRESS_ALLOWLIST=

# A PEM bundle to trust in addition to the system store, for a corporate proxy
# that terminates TLS.
# optional, no default
# NINJASRE_CA_BUNDLE=


# --- The ninjasre command ----------------------------------------------------

# Which deployment the ninjasre command talks to.
# optional, default: http://localhost:8420
# NINJASRE_ENDPOINT=http://localhost:8420

# Whether the command renders for a person or emits JSON for a script.
# optional, no default
# NINJASRE_OUTPUT_FORMAT=

# Turns colour off, for a terminal or a CI log that does not want it.
# optional, no default
# NINJASRE_NO_COLOR=
