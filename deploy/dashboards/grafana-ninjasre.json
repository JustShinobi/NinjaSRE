        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (team, model, provider) (rate(llm_cost_usd_total[$__rate_interval]))",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
