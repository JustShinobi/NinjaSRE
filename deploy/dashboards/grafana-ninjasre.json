        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (team, model, provider) (rate(llm_output_tokens_total[$__rate_interval]))",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
