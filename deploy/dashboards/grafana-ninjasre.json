{
  "title": "NinjaSRE",
  "uid": "ninjasre-reference",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "ninjasre",
    "sre"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Investigation — volume, duration, and how runs end",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Investigations started, by team, trigger, and how they ended",
      "id": 2,
      "description": "OTLP instrument `investigation.count` (counter, unit 1).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (team, trigger, outcome) (rate(investigation_count_total[$__rate_interval]))",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Wall-clock seconds from an investigation starting to its answer",
      "id": 3,
      "description": "OTLP instrument `investigation.duration` (histogram, unit s).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, team, trigger, outcome) (rate(investigation_duration_bucket[$__rate_interval])))",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "How investigations ended, so the distribution is readable on its own",
      "id": 4,
      "description": "OTLP instrument `investigation.outcome` (counter, unit 1).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (team, trigger, outcome) (rate(investigation_outcome_total[$__rate_interval]))",
          "legendFormat": "{{team}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cost — tokens and money, by team, model, and provider",
      "id": 5,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Uncached prompt tokens, by team, model, and provider",
      "id": 6,
