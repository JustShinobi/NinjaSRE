#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd -- "$script_dir/../.." && pwd)"

cd -- "$repository_root"

export PATH="$HOME/.local/bin:$PATH"
if ! command -v uv >/dev/null 2>&1; then
  # The official installer rather than pip. A CI runner image commonly ships a
  # Python with no pip module at all, and `python3 -m pip install --user uv`
  # fails there before anything this contract is about has been checked.
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
fi

if ! command -v make >/dev/null 2>&1; then
  # `make verify` is this repository's declared gate, and the runner image is
  # deliberately minimal — it ships no build tools at all. Installing the one
  # this contract names is cheaper than restating the gate here, which would
  # drift from the Makefile the moment either changed.
  if command -v sudo >/dev/null 2>&1; then
    sudo apt-get update -qq && sudo apt-get install -y -qq make
  else
    apt-get update -qq && apt-get install -y -qq make
  fi
fi

uv sync
export NINJASRE_CHAOS_KUBECONFIG=/dev/null
exec make verify
