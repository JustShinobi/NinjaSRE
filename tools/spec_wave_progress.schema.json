{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninjasre.local/schemas/spec-wave-progress.json",
  "title": "Spec wave resumable progress",
  "type": "object",
  "required": [
    "schema_version",
    "wave",
    "status",
    "runtime",
    "active_run",
    "feature_order",
    "current_feature",
    "completed_features",
    "last_verdict",
    "last_gate",
    "open_questions",
    "last_checkpoint",
    "next_action",
    "fingerprint",
    "features"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "wave": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["pending", "running", "paused", "failed", "blocked", "complete"]
    },
    "runtime": { "enum": ["claude", "codex", null] },
    "active_run": {
      "type": ["object", "null"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "paused", "complete", "abandoned"] },
        "runtime": { "enum": ["claude", "codex"] },
        "checkpoint_seq": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "string", "minLength": 1 },
        "updated_at": { "type": "string", "minLength": 1 }
      },
      "required": [
        "run_id",
        "status",
        "runtime",
        "checkpoint_seq",
        "started_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "feature_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "slots": { "type": "object", "additionalProperties": true },
    "current_feature": { "type": ["string", "null"] },
    "completed_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "last_verdict": { "type": ["string", "object", "null"] },
    "last_gate": { "type": ["string", "null"] },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "last_checkpoint": {
      "type": ["object", "null"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "phase": { "$ref": "#/$defs/phase" },
        "status": { "$ref": "#/$defs/status" },
        "at": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      },
      "required": ["seq", "phase", "status", "at", "summary"],
      "additionalProperties": true
    },
    "next_action": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": ["string", "null"] },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" },
      "uniqueItems": true
    },
    "history": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "phase": {
      "enum": [
        "initialize",
        "analyze",
        "implement",
        "converge",
        "automated_validation",
        "visual_review",
        "verify",
        "advance"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "passed",
        "failed",
        "unverified",
        "blocked",
        "paused",
        "not_required"
      ]
    },
    "checkpoint": {
      "type": ["object", "null"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "phase": { "$ref": "#/$defs/phase" },
        "status": { "$ref": "#/$defs/status" },
        "at": { "type": "string", "minLength": 1 }
      },
      "required": ["seq", "phase", "status", "at"],
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "command": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "commands": { "type": "array", "items": { "type": "string" } },
        "findings": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "recorded_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "feature": {
      "type": "object",
      "required": [
        "path",
        "dependencies",
        "phase",
        "status",
        "runtime",
        "last_checkpoint",
        "next_action",
        "worktree",
        "lifecycle_results",
        "playwright_result",
        "visual_result",
        "verifier_result",
        "fingerprint"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "phase": { "$ref": "#/$defs/phase" },
        "status": { "$ref": "#/$defs/status" },
        "runtime": { "enum": ["claude", "codex", null] },
        "last_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "next_action": { "type": "string", "minLength": 1 },
        "worktree": {
          "type": ["object", "null"],
          "properties": {
            "mode": { "enum": ["shared", "isolated"] },
            "path": { "type": "string", "minLength": 1 },
            "base_commit": { "type": "string", "minLength": 1 },
            "commit": { "type": ["string", "null"] }
          },
          "required": ["mode", "path", "base_commit", "commit"],
          "additionalProperties": true
        },
        "lifecycle_results": {
          "type": "object",
          "required": ["analyze", "implement", "converge"],
          "properties": {
            "analyze": { "$ref": "#/$defs/result" },
            "implement": { "$ref": "#/$defs/result" },
            "converge": { "$ref": "#/$defs/result" }
          },
          "additionalProperties": true
        },
        "playwright_result": {
          "allOf": [
            { "$ref": "#/$defs/result" },
            {
              "type": "object",
              "properties": {
                "backing": { "type": ["string", "null"] },
                "tests": { "type": "array", "items": { "type": "object" } }
              }
            }
          ]
        },
        "visual_result": {
          "allOf": [
            { "$ref": "#/$defs/result" },
            {
              "type": "object",
              "properties": {
                "reviewer": { "type": ["string", "null"] },
                "runtime": { "enum": ["claude", "codex", null] },
                "routes": { "type": "array", "items": { "type": "string" } },
                "viewports": { "type": "array", "items": { "type": "string" } }
              }
            }
          ]
        },
        "verifier_result": { "$ref": "#/$defs/result" },
        "fingerprint": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
