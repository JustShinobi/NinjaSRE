{
  "components": {
    "schemas": {
      "BackupJob": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "type": "string"
          },
          "covered": {
            "type": "integer"
          },
          "covers_all": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "job_id": {
            "type": "string"
          },
          "keep_last": {
            "type": "integer"
          },
          "last_run_at": {
            "$ref": "#/components/schemas/NullableString"
          },
          "node": {
            "$ref": "#/components/schemas/NullableString"
          },
          "resource_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "schedule": {
            "type": "string"
          },
          "uncovered": {
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "comment",
          "node",
          "schedule",
          "enabled",
          "covers_all",
          "resource_ids",
          "keep_last",
          "last_run_at",
          "covered",
          "uncovered"
        ],
        "type": "object"
      },
      "BackupJobList": {
        "additionalProperties": false,
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/BackupJob"
            },
            "type": "array"
          }
        },
        "required": [
          "jobs"
        ],
        "type": "object"
      },
      "Datastore": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "status": {
            "enum": [
              "available",
              "unknown",
              "unavailable"
            ],
            "type": "string"
          },
          "total_bytes": {
            "$ref": "#/components/schemas/NullableInteger"
          },
          "used_bytes": {
            "$ref": "#/components/schemas/NullableInteger"
          },
          "used_percent": {
            "$ref": "#/components/schemas/NullableNumber"
          }
        },
        "required": [
          "name",
          "node",
          "kind",
          "used_bytes",
          "total_bytes",
          "used_percent",
          "status"
        ],
        "type": "object"
      },
      "Node": {
        "additionalProperties": false,
        "properties": {
          "bridges": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cpu_percent": {
            "type": "number"
          },
          "expected_votes": {
            "type": "integer"
          },
          "failed_units": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "guests": {
            "type": "integer"
          },
          "kernel_installed": {
            "type": "string"
          },
          "kernel_running": {
            "type": "string"
          },
          "memory_percent": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "pending_updates": {
            "type": "integer"
          },
          "quorum_votes": {
            "type": "integer"
          },
          "role": {
            "enum": [
              "primary",
              "secondary"
            ],
            "type": "string"
          },
          "root_filesystem_percent": {
            "type": "number"
          },
          "security_updates": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "node_id",
          "name",
          "role",
          "version",
          "kernel_running",
          "kernel_installed",
          "cpu_percent",
          "memory_percent",
          "root_filesystem_percent",
          "guests",
          "quorum_votes",
          "expected_votes",
          "failed_units",
          "bridges",
          "pending_updates",
          "security_updates"
        ],
        "type": "object"
      },
      "NodeList": {
        "additionalProperties": false,
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "type": "array"
          }
        },
        "required": [
          "nodes"
        ],
        "type": "object"
      },
      "NullableInteger": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "NullableNumber": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "NullableString": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "StorageView": {
        "additionalProperties": false,
        "properties": {
          "datastores": {
            "items": {
              "$ref": "#/components/schemas/Datastore"
            },
            "type": "array"
          },
          "thin_pools": {
            "items": {
              "$ref": "#/components/schemas/ThinPool"
            },
            "type": "array"
          },
          "volumes": {
            "items": {
              "$ref": "#/components/schemas/Volume"
            },
            "type": "array"
          }
        },
        "required": [
          "datastores",
          "thin_pools",
          "volumes"
        ],
        "type": "object"
      },
      "ThinPool": {
        "additionalProperties": false,
        "properties": {
          "data_percent": {
            "type": "number"
          },
          "metadata_percent": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "volume_group": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "volume_group",
          "node",
          "size_bytes",
          "data_percent",
          "metadata_percent"
        ],
        "type": "object"
      },
      "Volume": {
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string"
          },
          "pool": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "used_percent": {
            "type": "number"
          },
          "volume_id": {
            "type": "string"
          }
        },
        "required": [
          "volume_id",
          "resource_id",
          "node",
          "pool",
          "used_percent",
          "size_bytes"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The response shapes of the endpoints the gateway does not serve yet: the estate inventory, continuous observation, and the Proxmox integration. Fixtures for these paths are projected from a direct, read-only read of the cluster, so they are wrong in the same way the future endpoints would be wrong rather than in a way of their own. Each path is deleted from this file by the change that makes the gateway serve it; the fixture then comes from the gateway like every other.",
    "title": "NinjaSRE API \u2014 projected endpoints",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/estate/backups": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupJobList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Backup jobs, what they cover and whether they are enabled"
      }
    },
    "/v1/estate/nodes": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The cluster's nodes, their load and their failed units"
      }
    },
    "/v1/estate/storage": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Datastores, thin pools and per-guest volume fill"
      }
    }
  }
}
