  "info": {
    "description": "The response shapes of the endpoints the gateway does not serve yet: the estate inventory, continuous observation, and the Proxmox integration. Fixtures for these paths are projected from a direct, read-only read of the cluster, so they are wrong in the same way the future endpoints would be wrong rather than in a way of their own. Each path is deleted from this file by the change that makes the gateway serve it; the fixture then comes from the gateway like every other.",
    "title": "NinjaSRE API \u2014 projected endpoints",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/detectors": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectorList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Every shipped detector, its coverage and its last verdict"
      }
    },
    "/v1/estate/backups": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupJobList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Backup jobs, what they cover and whether they are enabled"
      }
    },
    "/v1/estate/nodes": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The cluster's nodes, their load and their failed units"
      }
    },
    "/v1/estate/storage": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageView"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Datastores, thin pools and per-guest volume fill"
      }
    },
    "/v1/incidents": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Open and recently closed incidents"
      }
    },
    "/v1/incidents/{incident_id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDetail"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "One incident, its subjects and the observations behind it"
      }
    },
    "/v1/observations": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "What the detectors saw, most recent first"
      }
    }
  }
}
