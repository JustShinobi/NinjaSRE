            "chunk_id": "doc-0001-0",
            "ordinal": 0,
            "text": "A datastore threshold cannot see a guest at the ceiling of its own volume. Read both, and alert on whichever is worse."
          },
          {
            "chunk_id": "doc-0001-1",
            "ordinal": 1,
            "text": "Growing the volume is reversible; growing the datastore usually is not."
          }
        ],
