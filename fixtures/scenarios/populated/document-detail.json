          {
            "chunk_id": "doc-0002-0",
            "ordinal": 0,
            "text": "An upgrade renamed the interfaces. The bridge could not be built, and every service that depended on it failed at once, including the monitoring."
          },
          {
            "chunk_id": "doc-0002-1",
            "ordinal": 1,
            "text": "The recovery needed physical access to both machines, because the path in depended on the thing that was down."
          }
        ],
