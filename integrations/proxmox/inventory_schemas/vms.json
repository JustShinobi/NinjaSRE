{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "declared virtual machines",
  "description": "The same declaration as the containers file, for full guests.",
  "type": "object",
  "required": ["virtual_machines"],
  "additionalProperties": false,
  "properties": {
    "virtual_machines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["vmid"],
        "additionalProperties": false,
        "properties": {
          "vmid": {"type": "integer", "minimum": 100},
          "name": {"type": "string"},
          "node": {"type": "string"},
          "criticality": {"type": "string"},
          "tier": {"type": "string"},
          "owner": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    }
  }
}
