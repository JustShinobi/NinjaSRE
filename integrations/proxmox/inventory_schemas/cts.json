{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "declared containers",
  "description": "What the operator says each container is for. VMID is the only field the hypervisor API and this file both chose, so it is the only one identity is matched on.",
  "type": "object",
  "required": [
    "containers"
  ],
  "additionalProperties": true,
  "properties": {
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vmid"
        ],
        "additionalProperties": true,
        "properties": {
          "vmid": {
            "type": "integer",
            "minimum": 100
          },
          "name": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "criticality": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          }
        }
      }
    }
  }
}
