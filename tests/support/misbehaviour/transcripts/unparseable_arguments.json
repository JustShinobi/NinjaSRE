        "required": ["query"]
      }
    }
  ],
  "outputs": [
    {
      "text": "Calling prometheus_query with {\"query\": ",
      "tool_calls": [],
      "finish_reason": "length"
    },
    {
      "text": "",
      "tool_calls": [
        {"id": "call-1", "name": "prometheus_query", "arguments": {"query": "up"}}
      ],
      "finish_reason": "tool_calls"
    }
  ],
  "expected": {
    "repairs": ["no_tool_call_found"],
    "tool_calls": [{"name": "prometheus_query", "arguments": {"query": "up"}}]
  }
