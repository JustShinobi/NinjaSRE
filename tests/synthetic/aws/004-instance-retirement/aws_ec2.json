{
  "integration": "aws_ec2",
  "responses": [
    {
      "match": {
        "method": "GET",
        "query_contains": "Action=DescribeInstanceStatus"
      },
      "status": 200,
      "content_type": "text/xml",
      "body_text": "<?xml version=\"1.0\"?><DescribeInstanceStatusResponse><instanceStatusSet><item><instanceId>i-0a1</instanceId><instanceState><name>running</name></instanceState></item><item><instanceId>i-0a2</instanceId><instanceState><name>stopped</name></instanceState></item></instanceStatusSet></DescribeInstanceStatusResponse>"
    },
    {
      "match": {
        "method": "GET",
        "query_contains": "Action=DescribeInstances"
      },
      "status": 200,
      "content_type": "text/xml",
      "body_text": "<?xml version=\"1.0\"?><DescribeInstancesResponse><reservationSet><item><instanceId>i-0a2</instanceId><instanceType>m6i.large</instanceType></item></reservationSet></DescribeInstancesResponse>"
    }
  ]
}
